<module name = "">
    <bean name="ConditionDef" sep="," comment="条件">
    </bean>
    <bean name="TrueConditionDef" sep="," parent="ConditionDef" comment="始终成立" alias="始终成立">
    </bean>
    <bean name="FalseConditionDef" sep="," parent="ConditionDef" comment="始终不成立" alias="始终不成立">
    </bean>
    <bean name="AllConditionDef" sep="," parent="ConditionDef" comment="全部成立" alias="全部成立">
        <var name="conditions" type="(array#sep=|),ConditionDef" comment="条件列表"/>
    </bean>
    <bean name="AnyConditionDef" sep="," parent="ConditionDef" comment="任一成立" alias="任一成立">
        <var name="conditions" type="(array#sep=|),ConditionDef" comment="条件列表"/>
    </bean>
    <enum name="VariableComparisonOperator">
        <var name="Equal" value="0" alias="等于"/>
        <var name="NotEqual" value="1" alias="不等于"/>
        <var name="Greater" value="2" alias="大于"/>
        <var name="GreaterOrEqual" value="3" alias="大于等于"/>
        <var name="Less" value="4" alias="小于"/>
        <var name="LessOrEqual" value="5" alias="小于等于"/>
    </enum>
    <bean name="GameVariableConditionDef" sep="," parent="ConditionDef" comment="游戏变量" alias="游戏变量">
        <var name="variableId" type="int#ref=GameVariableTable"/>
        <var name="comparison" type="VariableComparisonOperator"/>
        <var name="value" type="int"/>
    </bean>
    <bean name="GameSwitchConditionDef" sep="," parent="ConditionDef" comment="游戏开关" alias="游戏开关">
        <var name="switchId" type="int#ref=GameSwitchTable"/>
        <var name="value" type="bool"/>
    </bean>
    <bean name="GlobalVariableConditionDef" sep="," parent="ConditionDef" comment="全局变量" alias="全局变量">
        <var name="variableId" type="int#ref=GlobalVariableTable"/>
        <var name="comparison" type="VariableComparisonOperator"/>
        <var name="value" type="int"/>
    </bean>
    <bean name="GlobalSwitchConditionDef" sep="," parent="ConditionDef" comment="全局开关" alias="全局开关">
        <var name="switchId" type="int#ref=GlobalSwitchTable"/>
        <var name="value" type="bool"/>
    </bean>
</module>
