    </bean>
    <bean name="TrueConditionDef" sep="," parent="ConditionDef" comment="始终成立" alias="始终成立">
    </bean>
    <bean name="FalseConditionDef" sep="," parent="ConditionDef" comment="始终不成立" alias="始终不成立">
